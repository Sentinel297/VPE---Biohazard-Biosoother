	<iconPath>UI_BiohazardSTNL/Abilities/Wastefocus</iconPath>
	<abilityClass>VPE_Biohazard.Ability_PollutionFocus</abilityClass>
	<castTime>60</castTime>
	<chance>0</chance>
	<!-- <goodwillImpact>-100</goodwillImpact> -->
